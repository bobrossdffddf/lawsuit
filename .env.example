# ─────────────────────────────────────────────────────────────
#  FLGOV JUDICIAL BOT — configuration
#  Copy this file to `.env` and fill in every value.
#  Turn on Developer Mode in Discord (Settings > Advanced) to
#  right-click > "Copy ID" on any role / channel / category.
# ─────────────────────────────────────────────────────────────

# --- Bot credentials -----------------------------------------
# Bot > Token in the Discord Developer Portal
DISCORD_TOKEN=
# General Information > Application ID
CLIENT_ID=
# Right-click your server > Copy Server ID
GUILD_ID=

# --- Roles ---------------------------------------------------
# Clerks: can open/deny cases, approve/deny every step, use /add and /addjudge
CLERK_ROLE_ID=1532849857524531320
# Judges: full read/write access to every case channel, can be assigned via /addjudge
JUDGE_ROLE_ID=1536152046774788147
# Optional: a role allowed to run $lawsuits / /panel. Leave blank to require
# Manage Server permission instead.
PANEL_MANAGER_ROLE_ID=

# --- Channels & categories -----------------------------------
# Category new civil case channels are created inside
CIVIL_CASE_CATEGORY_ID=1536111208900595742
# Support / questions channel referenced in the copy ("please visit #...")
SUPPORT_CHANNEL_ID=1533695207386910751
# Optional: channel that gets a log line for every case action. Blank = off.
LOG_CHANNEL_ID=
# Optional: channel for the custom welcome message. Blank = off.
WELCOME_CHANNEL_ID=

# --- Branding ------------------------------------------------
# Header / footer banners used in every embed
BANNER_URL=https://i.postimg.cc/43Cv9R3V/flgovlawsuits.webp
FOOTER_URL=https://i.postimg.cc/5tc5CWtT/flgov-footer.webp
# The seal emoji that prefixes every title. Must be an emoji the bot can see.
SEAL_EMOJI=<:unknown:1536074768187654245>
# Accent bar colour on containers (hex, no #)
ACCENT_COLOR=B3995D

# --- Behaviour -----------------------------------------------
# Prefix for text commands ($lawsuits)
PREFIX=$
# Two-digit year used in case numbers. Blank = use the real current year.
CASE_YEAR_OVERRIDE=
# DPI used when rendering uploaded PDFs to images for clerk review
PDF_RENDER_DPI=110
# Max pages rendered per uploaded PDF (Discord galleries hold 10 items)
PDF_MAX_PAGES=10
# What to do with a case channel after a clerk denies intake:
#   lock    = keep the channel, remove everyone's access (recommended, keeps records)
#   delete  = delete the channel after DELETE_DELAY_SECONDS
DENIED_CASE_ACTION=lock
DELETE_DELAY_SECONDS=60

# --- Departments (for the "Sue a Department" button) ----------
# Comma-separated list, shown as choices in the department modal.
DEPARTMENTS=Florida Highway Patrol,Clearwater Police Department,Pinellas County Sheriff's Office,Department of Corrections,Fire Rescue,Department of Transportation,Office of the Governor,Department of Health
